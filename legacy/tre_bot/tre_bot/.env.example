# Copy this file to .env and fill in your real credentials.
# .env should NEVER be committed to version control.

# Alpaca (free/IEX plan — Q7)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# TopstepX / ProjectX Gateway API
# Requires "API Access" enabled on your TopstepX account (Subscriptions
# > API Access, $29/mo) and a generated API key.
TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=

# The specific TopstepX account ID to trade (Combine or funded — same
# bot code either way). Find this by temporarily printing the output
# of TopstepXClient.search_accounts() and reading off the "id" field
# for the correct account.
TOPSTEPX_ACCOUNT_ID=

# Optional overrides — defaults live in config.py
# TRE_LEVELS_FILE=levels.csv
# TRE_LOG_FILE=tre_log.csv
