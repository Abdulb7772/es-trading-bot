NODE_ENV=development
LOG_LEVEL=info
API_PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_DATABASE=es_trading_bot
TOPSTEPX_BASE_URL=https://api.topstepx.com
TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=
TOPSTEPX_ACCOUNT_ID=
DRY_RUN=true
ENABLE_ES=true
ENABLE_MES=false
MAX_DAILY_LOSS=1000
LEVELS_FILE=backend/levels/es.csv
TRADING_TIMEZONE=America/New_York
NO_NEW_TRADES_AT_OR_AFTER=16:00