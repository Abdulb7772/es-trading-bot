{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve"
  },
  "include": ["backend/apps/**/*.ts", "backend/apps/**/*.tsx", "backend/packages/**/*.ts", "backend/packages/**/*.tsx", "backend/tests/**/*.ts", "frontend/**/*.ts", "frontend/**/*.tsx", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
